{
  "name": "@studio/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Angular UI.",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint && node --test tools/",
