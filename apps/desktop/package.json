{
  "name": "@studio/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron shell: window, lifecycle, spawns the backend.",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "install-electron",
    "install-electron": "install-electron",
    "check-electron": "node scripts/check-electron.cjs",
    "start": "node scripts/check-electron.cjs && electron .",
    "dev": "pnpm --filter @studio/ui build && pnpm run build && node scripts/check-electron.cjs && electron ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "eslint": "^10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  }
}
