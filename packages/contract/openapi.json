      "WsServerMessage": {
        "discriminator": {
          "mapping": {
            "error": "#/components/schemas/WsError",
            "ping": "#/components/schemas/WsPing",
            "pong": "#/components/schemas/WsPong",
            "project.created": "#/components/schemas/WsProjectCreated",
