      "OpenWorkspaceRequest": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Absolute folder path. An existing workspace is opened; an empty or missing folder is initialised as a new workspace.",
            "minLength": 1,
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "OpenWorkspaceRequest",
        "type": "object"
      },
      "Problem": {
        "description": "Why a workspace or project is in the `error` state.",
        "properties": {
          "code": {
            "enum": [
              "workspace_not_open",
              "workspace_in_use",
              "workspace_not_empty",
              "invalid_workspace_path",
              "project_not_found",
              "project_id_taken",
              "invalid_project_id",
              "project_read_only",
              "file_invalid",
              "file_too_new",
              "migration_failed"
            ],
            "title": "Code",
            "type": "string"
          },
