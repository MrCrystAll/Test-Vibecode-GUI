          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Project": {
        "description": "One project folder of the workspace.\n\n`status: \"error\"` projects are listed so the user can see and fix them, but they are read-only:\n`PATCH` and `DELETE` answer `project_read_only`.",
        "properties": {
          "file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectFile"
              },
              {
                "type": "null"
              }
            ],
            "description": "The parsed `project.json` (TC-32 schema); `null` when it can't be read."
          },
          "id": {
            "description": "The folder name. Immutable.",
            "title": "Id",
            "type": "string"
          },
          "path": {
            "description": "Absolute path of the project folder.",
            "title": "Path",
            "type": "string"
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when `status` is `error`."
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "status",
          "file"
        ],
        "title": "Project",
        "type": "object"
      },
      "ProjectEventPayload": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
